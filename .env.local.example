# ============================================================
# Pontai Stage 0 Environment Variables
# Copy to .env.local and fill in real values for local dev.
# In Railway production, set these via Railway dashboard.
# ============================================================

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Database (Railway PostgreSQL) ----------
DATABASE_URL=postgres://user:pass@localhost:5432/pontai

# ---------- Better Auth ----------
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------- Cloudflare R2 (S3-compatible) ----------
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pontai-uploads
R2_PUBLIC_URL=

# ---------- Inngest ----------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------- Resend (Email) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Pontai <[email protected]>"
# comma-separated emails receiving lead notifications
RESEND_ADMIN_EMAIL=

# ---------- AI Providers ----------
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# optional OCR fallback
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ---------- Admin Access ----------
# comma-separated emails of admins
ADMIN_EMAILS=

# ---------- Company Info (for contract templates & bank transfer page) ----------
COMPANY_NAME=
COMPANY_LEGAL_REPRESENTATIVE=
COMPANY_ADDRESS=
COMPANY_UNIFIED_SOCIAL_CREDIT_CODE=
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

# ---------- E-signature Provider (Day 5) ----------
# values: 'stub' | 'esignbao' | 'pandadoc'
ESIGN_PROVIDER=stub
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# ---------- SMS Provider (短信验证码) ----------
# values: 'stub' | 'aliyun' | 'tencent'
# stub 模式：不真发短信，仅在控制台打印 + dev 接口返回 OTP 用于测试
# 切换到 aliyun 时需要补齐下列字段
SMS_PROVIDER=stub
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE_REGISTER=
ALIYUN_SMS_TEMPLATE_CODE_RESET=
